{
  "name": "link-organizer",
  "version": "1.0.0",
  "description": "A desktop app for organizing and exporting web links",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "dist": "electron-builder",
    "preview": "vite preview"
  },
  "keywords": [
    "electron",
    "bookmark",
    "link-manager",
    "hugo"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^7.0.0",
    "clsx": "^2.0.0",
    "electron-store": "^8.1.0",
    "node-fetch": "^3.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "uuid": "^9.0.0",
    "zustand": "^4.4.0"
  },
  "build": {
    "appId": "com.linkorganizer.app",
    "productName": "Link Organizer",
    "directories": {
      "output": "build-out"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/renderer/ico/Favicon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/renderer/ico/Favicon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/renderer/ico/Favicon.png"
    }
  }
}
